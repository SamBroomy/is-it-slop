*
!*/
# Ensures the .git directory is included when release-plz copies the project in a temp dir
!.git/
!.git/**

/target

!.gitignore
!.gitattributes
!/crates/**/*.rs
!/crates/**/README.md
!/crates/**/Cargo.toml
!/Cargo.toml
!/Cargo.lock
!justfile
!install.sh
!install.ps1
!rust-toolchain.toml
!rustfmt.toml
!ruff.toml
!pyproject.toml
!uv.lock
!.python-version
!/README.md
!/NEXT_RELEASE.md
!/EXPERIMENTS.md
!/LICENSE
!/plots/*.png
!/plots/*.svg
!/python/**/*.py
!/python/**/py.typed
!/python/**/LICENSE
!/.cargo/config.toml
!/python/**/README.md
!.pre-commit-config.yaml
!/.github/workflows/**/*.yaml
!/.github/workflows/**/*.md
!release-plz.toml
!/crates/**/CHANGELOG.md
!.taplo.toml
!.vscode/settings.json
!assets/pink-307853.svg
!model_artifacts/.gitkeep
!data/.gitkeep
# Golden-vector fixtures: small trained weights + expected outputs the parity tests assert against.
!/crates/is-it-slop-training/tests/fixtures/*.safetensors
!/crates/is-it-slop-training/tests/fixtures/*.json
!/crates/is-it-slop/benches/corpus.jsonl
!/crates/is-it-slop/tests/fixtures/*.json

# Android library (everything lives under /android; see android/README.md)
!/android/README.md
!/android/justfile
!/android/gradlew
!/android/gradlew.bat
!/android/gradle/wrapper/gradle-wrapper.jar
!/android/**/*.kt
!/android/**/*.kts
!/android/**/*.rs
!/android/**/*.xml
!/android/**/*.pro
!/android/**/*.toml
!/android/**/*.properties
/android/**/build/
/android/**/.gradle/
/android/**/.kotlin/
/android/local.properties

# Dataset curation pipeline and its tests
!/curation/**/*.py
!/curation/*.toml
!/tests/**/*.py
!/scripts/*.py
